__pycache__/
*.py[cod]
sessions/
# Alloy's own memory: Josh's working notes about his projects, plus what the
# seats and the Supervisor recorded. Personal and per-machine, like sessions/,
# and it would churn on every /remember.
memory/
.codex-last-message-*.txt
ui/_harness.html
# Generated by ai-chat from this repo's own CLAUDE.md/README.md whenever a chat
# runs with --workspace here. It is a cache keyed on those files' sha256, so
# committing it would churn on every doc edit AND park a lossy summary of
# CLAUDE.md next to CLAUDE.md — a second source of truth that drifts. Rebuild
# cost is one cheap CLI call, and only when the sources actually change.
AI-CHAT.md
# One-off operator briefs belong to the local workflow, not source history.
PROMPT.txt
# app.py's stdout/stderr when launched from the desktop shortcut
app-stdout.log
app-stderr.log
# chat-input attachments saved by the app when a conversation uses this repo
# as its working folder — conversation artifacts, not source
attachments/
*.png
*.jpg
_*.txt

# builder: report screenshots are documentation (fixture lamp); everything under e11-mast is the owner's
!docs/reports/phase3/*.png
!docs/reports/phase4/*.png
docs/reports/e11-mast/
# builder: workflow state and Blender files must never be committed
*.blend
*.blend1
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
alloy-builder/
.pytest_cache/
